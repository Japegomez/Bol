{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/r/:token",
        "destination": "https://hxtynisikjpwlvpdgdbt.supabase.co/functions/v1/share-landing/r/:token",
        "type": 302
      },
      {
        "source": "/p/:recipeId",
        "destination": "https://hxtynisikjpwlvpdgdbt.supabase.co/functions/v1/share-landing/p/:recipeId",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
