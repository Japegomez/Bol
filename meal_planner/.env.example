# Copy to .env for local reference — values are passed at build/run time via --dart-define.
# Do NOT commit .env with real secrets.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Solo para generar modelos Dart (supadart). Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/0000000
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# Secreto compartido para Edge Functions (moderate-image, translate-recipe): supabase secrets set
GOOGLE_API_KEY=your-google-api-key
# Asistente IA de recetas (recipe-assistant): supabase secrets set
# Opción A — Cerebras (recomendado): https://cloud.cerebras.ai
LLM_API_KEY=csk_your-cerebras-api-key
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=gpt-oss-120b
# Opción B — Google Gemini
# LLM_API_KEY=your-gemini-api-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# Opción C — Groq: https://console.groq.com/keys
# LLM_API_KEY=gsk_your-groq-api-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
